# vim: set ft=sh noet:
! declare 2>&1 | grep -wq ^colors= && [ $BASH_VERSINFO -ge 4 ] && source $initDir/.colors
test "$debug" -gt 0 && echo "=> Running $bold${colors[blue]}$(basename ${BASH_SOURCE[0]})$normal ..."

export kubectl="$sudo $(type -P kubectl)"
kubectl completion $(basename $SHELL) > ~/.local/share/bash-completion/completions/kubectl
source ~/.local/share/bash-completion/completions/kubectl

if which kubectl-vsphere >/dev/null;then
	kubectl-vsphere completion $(basename $SHELL) > ~/.local/share/bash-completion/completions/kubectl-vsphere
	source ~/.local/share/bash-completion/completions/kubectl-vsphere
fi

set +x
test "$debug" -gt 0 && echo "=> END of $bold${colors[blue]}$(basename ${BASH_SOURCE[0]})$normal"
