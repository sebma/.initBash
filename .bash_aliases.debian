# vim: ft=bash noet:

! declare 2>&1 | grep -wq ^colors= && [ $BASH_VERSINFO -ge 4 ] && source $initDir/.colors
test "$debug" -gt 0 && \echo "=> Running $bold${colors[blue]}$(basename ${BASH_SOURCE[0]})$normal ..."

LANGUAGE_OLD=$LANGUAGE
LANGUAGE=C.UTF-8

apt="$(type -P apt) -q=0"
apt_get=$(type -P apt-get)

#alias installSecurityUpdates="sudo apt install -V $(apt-get -s dist-upgrade | awk "/^Inst.*\/$codeName-security/"'{print$2}')"
alias architecture="dpkg --print-architecture"

[ -n "$SSH_CONNECTION" ] && type -P screen >/dev/null 2>&1 && screen="screen -L"

alias autoremove="( $apt -h 2>&1 | \grep -wq autoremove && $apt autoremove -s | \grep -wq '^Remv' && $sudo $screen $apt autoremove -V ) || $apt_get autoremove -s | \grep -wq '^Remv' && $sudo $screen $apt_get autoremove -V"
alias cleanupOldKernels='linux-version list;\linux-purge -l -k 2 | grep -q linux && set -x && $sudo $screen $apt purge -V $(\linux-purge -l -k 2); set +x'
alias do-release-upgrade='$sudo $screen do-release-upgrade'
alias upgrade="LANGUAGE=$LANGUAGE $apt_get upgrade -s | \grep '^[1-9][0-9]* upgraded' && $sudo $apt upgrade -V --download-only && sync && $sudo $screen $apt upgrade -V --yes;sync"
alias dist-upgrade="sudo $apt dist-upgrade -V --no-remove --download-only && sync && $sudo $screen $apt dist-upgrade -V --no-remove --yes;sync"
alias full-upgrade="sudo $apt full-upgrade -V --no-remove --download-only && sync && $sudo $screen $apt full-upgrade -V --no-remove --yes;sync"
alias installSecurityUpdates="\apt list --upgradable 2>/dev/null | awk -F/ '/security/{packages=packages\" \"\$1}END{if(packages){commandLine=\"sudo $screen apt install -V -y\"packages;print commandLine >\"/dev/stderr\";print commandLine;}}' | sh"
alias reinstallPkg="sudo $screen $apt install --reinstall -V"
alias reinstallPkgWithConfigFiles="sudo $screen $apt install --reinstall -V -o Dpkg::Options::=--force-confask,confnew,confmiss"

alias debExport=dpkg-repack
alias debInfo="\dpkg -I"
alias debContents="\dpkg-deb -c"
alias dupdatedb="time \sudo update-dlocatedb"
alias kdeVersion="dpkg -l | awk -F'[:-]' '/plasma-desktop\s/{print \$3}'"
alias lsNonPPAs=$'awk \'BEGINFILE{if(ERRNO)nextfile}/launchpad.*.net|esm.ubuntu.com|^#|^\s*$/{next} {sub("^.*https?","https")} /\s#/{print$1" # "$NF} !/\s#/{print$1}\' /etc/apt/sources.list.d/*.list | sort -u'
alias update="time $sudo $apt update && $apt list --upgradable"
alias upgradable="$apt list --upgradable"
alias webpage=website

LANGUAGE=$LANGUAGE_OLD
unset apt

set +x
test "$debug" -gt 0 && \echo "=> END of $bold${colors[blue]}$(basename ${BASH_SOURCE[0]})$normal"
