# vim: set ft=sh noet:
! declare 2>&1 | grep -wq ^colors= && [ $BASH_VERSINFO -ge 4 ] && source $initDir/.colors
test "$debug" -gt 0 && echo "=> Running $bold${colors[blue]}$(basename ${BASH_SOURCE[0]})$normal ..."

alias podmanCleanup="podman system prune"
alias podmanCleanOldImages="podman "'image prune --all --filter until=$((30*24))h'
alias podmanImageSizes=$'podman images --format "{{.ID}}\t{{.Size}}\t{{.CreatedSince}}\t{{.Repository}}:{{.Tag}}" | sort -k 2 -h'
alias podmanImagesBySize=$'podman images | awk \'NR<2{print $0;next}{print $0 | "sort -k7 -hr"}\' | head'
alias podmanUsageByCPU='podman stats --no-stream | { read header; echo "$header"; sort -k3 -nr; }'
alias podmanUsageByRAM='podman stats --no-stream | { read header; echo "$header"; sort -k4 -nr; }'

set +x
test "$debug" -gt 0 && echo "=> END of $bold${colors[blue]}$(basename ${BASH_SOURCE[0]})$normal"
